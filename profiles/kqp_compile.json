{
  "name": "kqp_compile",
  "title": "KQP compilation",
  "root": "Compile query",
  "query_text": {
    "attribute": "db.query.text",
    "label_regex": "^--\\s*(?P<group>\\S+)\\s+(?P<label>\\S+), level"
  },
  "attributes": {
    "cpu_us": {
      "span": "Compile query",
      "key": "ydb.cpu_us"
    },
    "cache_hit": {
      "span": "Get query plan",
      "key": "ydb.compile.cache_hit"
    },
    "database": {
      "span": "Query Proxy",
      "key": "db.namespace"
    }
  },
  "failure": {
    "detail_span": "Explain query"
  },
  "columns": [
    {
      "id": "front",
      "label": "YQL front end",
      "match": {
        "union_of": [
          "setup",
          "parse",
          "loop",
          "kql",
          "bridge"
        ]
      }
    },
    {
      "id": "setup",
      "label": "Setup and pipelines",
      "parent": "front",
      "match": {
        "names": [
          "Set up compilation",
          "Create transformer pipelines"
        ]
      }
    },
    {
      "id": "parse",
      "label": "Parse and translate",
      "parent": "front",
      "match": {
        "names": [
          "Parse query"
        ]
      }
    },
    {
      "id": "loop",
      "label": "Logical loop",
      "parent": "front",
      "match": {
        "names": [
          "Prepare logical query"
        ]
      }
    },
    {
      "id": "io",
      "label": "IO annotation",
      "parent": "loop",
      "match": {
        "names": [
          "Annotate IO"
        ]
      }
    },
    {
      "id": "types",
      "label": "Type annotation",
      "parent": "loop",
      "match": {
        "names": [
          "Annotate types"
        ]
      }
    },
    {
      "id": "providers",
      "label": "Provider optimizations",
      "parent": "loop",
      "match": {
        "names": [
          "Apply provider optimizations"
        ]
      }
    },
    {
      "id": "restarts",
      "label": "Repeated loop passes",
      "parent": "loop",
      "match": {
        "after_nth": {
          "anchor": "Annotate IO",
          "n": 2,
          "names": [
            "Annotate IO",
            "Annotate types",
            "Apply provider optimizations"
          ]
        }
      }
    },
    {
      "id": "kql",
      "label": "KQL build and annotation",
      "parent": "front",
      "match": {
        "names": [
          "Build KQL query",
          "Annotate KQL query"
        ]
      }
    },
    {
      "id": "bridge",
      "label": "Bridge to RBO operators",
      "parent": "front",
      "match": {
        "names": [
          "Rewrite select",
          "Convert to new RBO operators"
        ]
      }
    },
    {
      "id": "logical",
      "label": "Logical optimization",
      "match": {
        "names": [
          "Rule-based optimization",
          "Finalize new RBO operators",
          "Build plan JSON"
        ]
      }
    },
    {
      "id": "rules",
      "label": "RBO rules",
      "parent": "logical",
      "match": {
        "prefix": "Rule: "
      }
    },
    {
      "id": "cbo",
      "label": "CBO join order search",
      "parent": "rules",
      "match": {
        "names": [
          "Search join order",
          "Prepare join order search"
        ]
      }
    },
    {
      "id": "props",
      "label": "Property recomputation",
      "parent": "logical",
      "match": {
        "prefix": "Compute "
      }
    },
    {
      "id": "physical",
      "label": "Physical planning",
      "match": {
        "names": [
          "Convert to physical plan",
          "Compile physical query"
        ]
      }
    },
    {
      "id": "convert",
      "label": "Physical conversion",
      "parent": "physical",
      "match": {
        "names": [
          "Convert operators",
          "Build stage graph",
          "Build physical query",
          "Prepare physical stages"
        ]
      }
    },
    {
      "id": "peephole",
      "label": "Peephole",
      "parent": "physical",
      "match": {
        "names": [
          "Peephole physical stages"
        ]
      }
    },
    {
      "id": "programs",
      "label": "Program compilation",
      "parent": "physical",
      "match": {
        "names": [
          "Compile physical query"
        ]
      }
    },
    {
      "id": "olap",
      "label": "OLAP programs",
      "parent": "programs",
      "match": {
        "names": [
          "Compile OLAP program"
        ]
      }
    },
    {
      "id": "explain",
      "label": "Explain plan",
      "match": {
        "names": [
          "Build explain plan"
        ]
      }
    },
    {
      "id": "waits",
      "label": "Waits for metadata",
      "match": {
        "names": [
          "Await table metadata",
          "Await column statistics"
        ]
      }
    },
    {
      "id": "other",
      "label": "Not under any span",
      "match": {
        "uncovered_by": [
          "front",
          "logical",
          "physical",
          "explain",
          "waits"
        ]
      }
    }
  ],
  "partition": [
    {
      "id": "setup",
      "label": "Setup and pipelines",
      "family": "front",
      "from": [
        "setup"
      ]
    },
    {
      "id": "parse",
      "label": "Parse and translate",
      "family": "front",
      "from": [
        "parse"
      ]
    },
    {
      "id": "types",
      "label": "Type annotation",
      "family": "front",
      "from": [
        "types"
      ]
    },
    {
      "id": "loop_rest",
      "label": "Rest of the logical loop",
      "family": "front",
      "from": [
        "loop"
      ]
    },
    {
      "id": "kql_bridge",
      "label": "KQL and bridge to RBO",
      "family": "front",
      "from": [
        "kql",
        "bridge"
      ]
    },
    {
      "id": "rbo",
      "label": "RBO rules and properties",
      "family": "logical",
      "from": [
        "logical"
      ]
    },
    {
      "id": "cbo",
      "label": "CBO join search",
      "family": "logical",
      "from": [
        "cbo"
      ]
    },
    {
      "id": "convert",
      "label": "Physical conversion",
      "family": "physical",
      "from": [
        "physical"
      ]
    },
    {
      "id": "peephole",
      "label": "Peephole",
      "family": "physical",
      "from": [
        "peephole"
      ]
    },
    {
      "id": "programs",
      "label": "Program compilation",
      "family": "physical",
      "from": [
        "programs"
      ]
    },
    {
      "id": "explain",
      "label": "Explain plan",
      "family": "other",
      "from": [
        "explain"
      ]
    },
    {
      "id": "waits",
      "label": "Waits for metadata",
      "family": "other",
      "from": [
        "waits"
      ]
    },
    {
      "id": "other",
      "label": "Not under any span",
      "family": "other",
      "from": [
        "other"
      ]
    }
  ],
  "partition_priority": [
    "waits",
    "cbo",
    "rbo",
    "peephole",
    "programs",
    "convert",
    "explain",
    "types",
    "loop_rest",
    "setup",
    "parse",
    "kql_bridge",
    "other"
  ],
  "families": [
    {
      "id": "front",
      "label": "YQL front end"
    },
    {
      "id": "logical",
      "label": "Logical optimization"
    },
    {
      "id": "physical",
      "label": "Physical planning"
    },
    {
      "id": "other",
      "label": "Explain, waits and the rest"
    }
  ],
  "counts": [
    {
      "id": "type_passes",
      "label": "Type annotation passes",
      "match": {
        "names": [
          "Annotate types"
        ]
      },
      "per_call_of": "types",
      "per_call_label": "Type annotation pass"
    },
    {
      "id": "kql_passes",
      "label": "KQL annotation passes",
      "match": {
        "names": [
          "Annotate KQL query"
        ]
      },
      "per_call_of": "kql",
      "per_call_label": "KQL annotation pass"
    },
    {
      "id": "rbo_runs",
      "label": "RBO runs",
      "match": {
        "names": [
          "Run new RBO"
        ]
      }
    },
    {
      "id": "stages",
      "label": "RBO stages run",
      "match": {
        "prefix": "RBO stage: "
      }
    },
    {
      "id": "rules",
      "label": "Rules applied",
      "match": {
        "prefix": "Rule: ",
        "not_suffix": " (not applied)"
      },
      "per_call_of": "rules",
      "per_call_label": "Applied rule"
    },
    {
      "id": "props",
      "label": "Property recomputations",
      "match": {
        "prefix": "Compute "
      },
      "per_call_of": "props",
      "per_call_label": "Property recomputation"
    },
    {
      "id": "joins",
      "label": "Join order searches",
      "match": {
        "names": [
          "Search join order"
        ]
      },
      "per_call_of": "cbo",
      "per_call_label": "Join order search"
    },
    {
      "id": "stage_programs",
      "label": "Stage programs",
      "match": {
        "names": [
          "Peephole stage"
        ]
      },
      "per_call_of": "peephole",
      "per_call_label": "Peephole of a stage"
    },
    {
      "id": "olap_programs",
      "label": "OLAP programs",
      "match": {
        "names": [
          "Compile OLAP program"
        ]
      },
      "per_call_of": "olap",
      "per_call_label": "OLAP program"
    },
    {
      "id": "tables",
      "label": "Table metadata requests",
      "match": {
        "names": [
          "Resolve table metadata"
        ]
      },
      "per_call_of": "waits",
      "per_call_label": "Metadata wait per table"
    },
    {
      "id": "spans",
      "label": "Spans",
      "match": {
        "all": true
      }
    }
  ],
  "containers": [
    "Compile query",
    "Prepare physical query",
    "Optimize query",
    "Run new RBO",
    "Release compilation state"
  ],
  "scenarios": [
    {
      "name": "Without setup and pipelines",
      "factors": {
        "setup": 0
      }
    },
    {
      "name": "Front end twice as fast",
      "families": {
        "front": 0.5
      }
    },
    {
      "name": "Direct SQL to RBO operators (illustrative)",
      "factors": {
        "setup": 0.3,
        "parse": 0.5,
        "types": 0.5,
        "loop_rest": 0,
        "kql_bridge": 0.2
      }
    },
    {
      "name": "Peephole twice as fast",
      "factors": {
        "peephole": 0.5
      }
    },
    {
      "name": "CBO three times slower (real statistics)",
      "factors": {
        "cbo": 3
      }
    }
  ]
}
