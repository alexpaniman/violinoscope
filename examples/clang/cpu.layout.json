{
  "format": "violinoscope-layout",
  "version": 4,
  "name": "Compiler components",
  "unit": "Sampled CPU",
  "tree": {
    "span": "Sampled CPU",
    "open": true,
    "children": [
      {
        "span": "clang::ParseAST",
        "name": "Front end",
        "open": true,
        "rest": true,
        "children": [
          {
            "span": "clang::Parser::ParseDeclaration",
            "name": "Declarations"
          },
          {
            "span": "clang::Parser::ParseFunctionDefinition",
            "name": "Function parsing"
          }
        ]
      },
      {
        "group": "Templates",
        "open": true,
        "children": [
          {
            "span": "clang::Sema::InstantiateClass",
            "name": "Classes"
          },
          {
            "span": "clang::Sema::InstantiateFunctionDefinition",
            "name": "Functions"
          }
        ]
      },
      {
        "span": "(anonymous namespace)::EmitAssemblyHelper::RunOptimizationPipeline",
        "name": "Optimization",
        "open": true,
        "rest": true,
        "children": [
          {
            "span": "llvm::InlinerPass::run",
            "name": "Inlining"
          }
        ]
      },
      {
        "span": "(anonymous namespace)::EmitAssemblyHelper::RunCodegenPipeline",
        "name": "Code generation",
        "open": true,
        "children": [
          {
            "span": "llvm::SelectionDAGISel::runOnMachineFunction",
            "name": "Instruction selection"
          }
        ]
      },
      {
        "group": "Repeated passes",
        "open": true,
        "children": [
          {
            "span": "llvm::InstCombinePass::run",
            "name": "Inst. combining"
          },
          {
            "span": "llvm::GVNPass::run",
            "name": "Value numbering"
          },
          {
            "span": "llvm::SimplifyCFGPass::run",
            "name": "CFG cleanup"
          }
        ]
      }
    ]
  },
  "projections": [
    {
      "span": "clang::ParseAST",
      "name": "Full front end",
      "open": true,
      "children": [
        {
          "span": "clang::Sema::InstantiateClass",
          "name": "Classes"
        },
        {
          "span": "clang::Sema::InstantiateFunctionDefinition",
          "name": "Functions"
        }
      ]
    }
  ]
}
